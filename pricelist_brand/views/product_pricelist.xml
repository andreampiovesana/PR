<odoo>
    <record model="ir.ui.view" id="product_pricelist_item_form_view">
        <field name="name">product.pricelist.item.form (in pricelist_brand)</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_rule_target']/field[@name='product_id']" position="after">
                <field
                    name="product_brand_id"
                    options="{'no_create': 1}"
                    readonly="categ_id or product_tmpl_id or product_id"
                    placeholder="All brands"
                />
            </xpath>
            <xpath expr="//group[@name='pricelist_rule_target']/field[@name='categ_id']" position="attributes">
                <attribute name="readonly">product_tmpl_id or product_id or product_brand_id</attribute>
            </xpath>
            <xpath expr="//group[@name='pricelist_rule_target']/field[@name='product_tmpl_id']" position="attributes">
                <attribute name="readonly">categ_id or product_brand_id</attribute>
            </xpath>
            <xpath expr="//group[@name='pricelist_rule_target']/field[@name='product_id']" position="attributes">
                <attribute name="readonly">categ_id or product_brand_id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
